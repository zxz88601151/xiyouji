{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "阿信电脑同步器",
  "version": "0.1.0",
  "identifier": "com.axin.multisync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "阿信电脑同步器",
        "label": "main",
        "width": 620,
        "height": 760,
        "minWidth": 520,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
